# Yalnızca ses seçme denemeleri dışarıda kalır.
bolumler/*/sesler/deneme/
bolumler/*/*.mp4

# macOS
.DS_Store

# Stil örneği görseli (kullanıcının dışarıdan verdiği görsel; cihazlar arası elle kopyalanır)
